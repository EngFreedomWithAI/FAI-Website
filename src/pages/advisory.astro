---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Field from '../components/Field.astro';
import TeamAvatar from '../components/TeamAvatar.astro';
import { advisors } from '../data/advisors';
import { workAreas } from '../data/engagements';
import '../styles/content-pages.css';

const pageTitle = 'Advisory | Freedom with AI';
const pageDescription =
  'Ongoing strategic advisory for founders leveraging AI while building and growing companies.';

const advisorySchema = {
  '@type': 'Service',
  name: 'Founder Advisory',
  description: pageDescription,
  provider: { '@id': `${Astro.site?.origin ?? 'https://freedomwith.ai'}/#organization` },
  areaServed: 'Worldwide',
  serviceType: [
    'Product strategy',
    'Technology strategy',
    'Growth strategy',
    'Regulatory strategy',
    'Risk and governance',
  ],
};
---

<Base title={pageTitle} description={pageDescription} schema={advisorySchema}>
  <Nav />

  <main id="main-content">
    <section class="page-hero" aria-labelledby="advisory-heading">
      <div class="container">
        <SectionHeader label="Advisory" align="left" />
        <h1 id="advisory-heading" class="page-hero__title">
          Advisory shaped around momentum.
        </h1>
        <p class="page-hero__lede">
          Founders bring us in when the answer is not obvious, the decision is consequential and
          generic advice is no longer useful.
        </p>
        <div class="page-hero__cta">
          <Button variant="primary" href="#start" size="large">Start a conversation</Button>
          <Button variant="secondary" href="#advisors" size="large">Meet the advisors</Button>
        </div>
      </div>
    </section>

    <!-- The work, by problem -->
    <section class="page-section page-section--alt" aria-labelledby="work-heading">
      <div class="container">
        <SectionHeader label="Where we help" align="left" />
        <h2 id="work-heading" class="page-section__heading">Four recurring company problems.</h2>
        <p class="page-section__sub">
          These problems appear across industries wherever products, buying decisions, operations
          or regulation are complex.
        </p>

        <div class="work-grid">
          {workAreas.map((area) => (
            <article class="work">
              <h3 class="work__title">{area.title}</h3>
              <p class="work__body">{area.body}</p>
              <ul class="work__list">
                {area.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section" id="advisors" aria-labelledby="practices-heading">
      <div class="container">
        <h2 id="practices-heading" class="page-section__heading">Advisors</h2>

        <div class="practices practices--compact">
          {advisors.map((advisor) => (
            <article class="practice">
              <div class="practice__head">
                <TeamAvatar member={advisor.slug} class="practice__photo" />
                <div>
                  <h3 class="practice__name">{advisor.name}</h3>
                  <p class="practice__role">{advisor.role}</p>
                </div>
              </div>
              <p class="practice__strengths">{advisor.strengths}</p>
              <p class="practice__credential">{advisor.credential}</p>
              <p class="practice__depth">{advisor.depth}</p>
              <a
                class="practice__link"
                href={advisor.linkedIn}
                target="_blank"
                rel="noopener noreferrer"
              >
                {advisor.name.split(' ')[0]} on LinkedIn <span aria-hidden="true">&nearr;</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="page-section page-section--alt" aria-labelledby="how-heading">
      <div class="container work-split">
        <div class="work-split__main">
          <SectionHeader label="How engagements work" align="left" />
          <h2 id="how-heading" class="page-section__heading">
            Decisions, carried through.
          </h2>
          <p class="page-section__sub">
            Engagements are shaped around the company’s priorities and evolve as decisions are made
            and new constraints emerge.
          </p>

          <ul class="check-list">
            <li>
              A company-level perspective across product, technology, growth, operations,
              regulation and risk
            </li>
            <li>Regular working sessions focused on the decisions in motion</li>
            <li>Direct access as questions surface between sessions</li>
            <li>Continuity from decision through execution</li>
          </ul>
        </div>

        <aside class="fit-card">
          <h3 class="fit-card__title">Is this a fit?</h3>
          <p>
            Best for founders actively building or growing a company, with meaningful decisions
            already in motion.
          </p>
          <p>
            We begin with a three- or six-month engagement. Scope and fee reflect the priorities
            and level of involvement.
          </p>
          <Button variant="primary" href="#start" size="large">Start a conversation</Button>
        </aside>
      </div>
    </section>

    <!-- Intake -->
    <section class="page-section" id="start" aria-labelledby="start-heading">
      <div class="container">
        <SectionHeader label="Start a conversation" align="left" />
        <h2 id="start-heading" class="page-section__heading">Tell us about the company</h2>
        <p class="page-section__sub">
          Tell us what the company does and what decision is in front of you.
        </p>

        <div
          id="form-success"
          class="form-banner form-banner--success"
          role="status"
          tabindex="-1"
          hidden
        >
          Thanks for getting in touch. We will reply within a few days.
        </div>

        <div id="form-error" class="form-banner form-banner--error" role="alert" hidden>
          Please complete the highlighted fields.
        </div>

        <form id="request-form" class="contact-form" novalidate aria-label="Start a conversation">
          <Field id="advisory-name" name="name" label="Name" type="text" required />
          <Field id="advisory-email" name="email" label="Email" type="email" required />
          <Field
            id="advisory-company-name"
            name="company_name"
            label="Company name"
            type="text"
            optional
          />
          <Field
            id="advisory-message"
            name="message"
            label="What does the company do, and what decision is in front of you"
            type="textarea"
            required
            placeholder="What you are building, who it is for, and the call you are trying to make in the next six months."
          />
          <Field
            id="advisory-link"
            name="link"
            label="Website, deck or LinkedIn"
            type="url"
            optional
            placeholder="yourcompany.com"
          />

          <input
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            class="contact-form__hp"
            aria-hidden="true"
          />

          <Button type="submit" variant="primary" size="large">Send</Button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* "How engagements work": copy on the left, the fit/commercial aside on the
     right, so the money question sits next to the description of the work
     rather than buried under it. */
  .work-split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-8);
    align-items: start;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--readw);
  }

  .check-list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  .check-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 12px;
    height: 1px;
    background: var(--color-accent);
  }

  .fit-card {
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .fit-card__title {
    font-size: var(--text-lg);
  }

  .fit-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .practices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .practice {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
  }

  .practice__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
  }

  .practice :global(.practice__photo) {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  .practice__name {
    font-size: var(--text-lg);
  }

  .practice__role {
    margin-top: 2px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
  }

  .practice__strengths {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .practice__credential {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .practice__depth {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    line-height: var(--leading-relaxed);
  }

  .practice__link {
    margin-top: auto;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .work {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 2px solid var(--color-text);
  }

  .work__title {
    font-size: var(--text-lg);
  }

  .work__body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .work__list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .work__list li {
    position: relative;
    padding-left: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .work__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 1px;
    background: var(--color-text-subtle);
  }

  @media (max-width: 880px) {
    .practices,
    .work-grid,
    .work-split {
      grid-template-columns: 1fr;
    }

    .work-split {
      gap: var(--space-7);
    }
  }
</style>

<script>
  import { normalizeUrl, isValidWebUrl, INVALID_URL_MESSAGE } from '../scripts/url';

  const form = document.getElementById('request-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('form-success');
  const errorBanner = document.getElementById('form-error');

  const fieldLabels: Record<string, string> = {
    name: 'Name',
    email: 'Email',
    message: 'What does the company do, and what decision is in front of you',
    link: 'Website, deck or LinkedIn',
  };

  const showFieldError = (name: string, message: string) => {
    const wrapper = form?.querySelector(`[data-field="${name}"]`);
    const control = wrapper?.querySelector<HTMLElement>('.field__control');
    const errorEl = wrapper?.querySelector<HTMLElement>('.field__error');
    if (!wrapper || !control || !errorEl) return;
    wrapper.classList.add('field--invalid');
    control.setAttribute('aria-invalid', 'true');
    errorEl.textContent = message;
    errorEl.hidden = false;
  };

  const clearFieldErrors = () => {
    form?.querySelectorAll('[data-field]').forEach((wrapper) => {
      wrapper.classList.remove('field--invalid');
      const control = wrapper.querySelector<HTMLElement>('.field__control');
      const errorEl = wrapper.querySelector<HTMLElement>('.field__error');
      control?.removeAttribute('aria-invalid');
      if (errorEl) {
        errorEl.textContent = '';
        errorEl.hidden = true;
      }
    });
  };

  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearFieldErrors();
      successBanner?.setAttribute('hidden', '');
      errorBanner?.setAttribute('hidden', '');

      const data = new FormData(form);
      let valid = true;

      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const companyName = String(data.get('company_name') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const link = normalizeUrl(String(data.get('link') ?? ''));

      if (!name) {
        showFieldError('name', `${fieldLabels.name} is required.`);
        valid = false;
      }

      if (!email) {
        showFieldError('email', `${fieldLabels.email} is required.`);
        valid = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showFieldError('email', 'Enter a valid email address.');
        valid = false;
      }

      if (!message) {
        showFieldError('message', 'Please tell us what decision you are facing.');
        valid = false;
      }

      if (link && !isValidWebUrl(link)) {
        showFieldError('link', INVALID_URL_MESSAGE);
        valid = false;
      }

      if (!valid) {
        errorBanner?.removeAttribute('hidden');
        const firstInvalid = form.querySelector<HTMLElement>('.field--invalid .field__control');
        firstInvalid?.focus();
        return;
      }

      const originalLabel = submitButton?.textContent;
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending...';
      }

      try {
        const res = await fetch('/api/advisory', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name, email, company_name: companyName, message, link }),
        });
        const result = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
          errors?: Record<string, string>;
        };

        if (!res.ok || !result.ok) {
          if (result.errors) {
            for (const [field, msg] of Object.entries(result.errors)) {
              showFieldError(field, msg);
            }
          }
          if (errorBanner) {
            errorBanner.textContent =
              result.error ??
              (result.errors
                ? 'Please complete the highlighted fields.'
                : 'Something went wrong. Please try again.');
            errorBanner.removeAttribute('hidden');
          }
          const firstInvalid = form.querySelector<HTMLElement>('.field--invalid .field__control');
          firstInvalid?.focus();
          return;
        }

        form.reset();
        successBanner?.removeAttribute('hidden');
        successBanner?.focus();
      } catch {
        if (errorBanner) {
          errorBanner.textContent = 'Network error. Please try again.';
          errorBanner.removeAttribute('hidden');
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalLabel ?? 'Send';
        }
      }
    });
  }
</script>
