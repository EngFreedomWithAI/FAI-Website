---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Field from '../components/Field.astro';
import TeamAvatar from '../components/TeamAvatar.astro';
import { advisorBySlug } from '../data/advisors';
import { focusAreas, supportingExperience } from '../data/engagements';
import { advisoryFocusOptions, advisoryStageOptions } from '../data/contact-form';
import '../styles/content-pages.css';

const pageTitle = 'Advisory | Freedom with AI';
const pageDescription =
  'Executive AI advisory with Sonia Sarao for founders, CEOs and leadership teams in space, defense and complex technology businesses: AI strategy and executive leadership, AI adoption across functions, and product and data strategy.';

const sonia = advisorBySlug('sonia');

const advisorySchema = {
  '@type': 'Service',
  name: 'Executive Advisory for AI Strategy',
  description: pageDescription,
  provider: { '@id': `${Astro.site?.origin ?? 'https://freedomwith.ai'}/#organization` },
  areaServed: 'Worldwide',
  serviceType: [
    'AI strategy',
    'AI adoption',
    'Product and data strategy',
    'Executive leadership coaching',
    'Fractional product and technology leadership',
  ],
};
---

<Base title={pageTitle} description={pageDescription} schema={advisorySchema}>
  <Nav />

  <main id="main-content">
    <section class="page-hero" aria-labelledby="advisory-heading">
      <div class="container">
        <SectionHeader label="Advisory" align="left" />
        <h1 id="advisory-heading" class="page-hero__title">
          Executive advisory for AI strategy.
        </h1>
        <p class="page-hero__tagline">Build AI capability from within.</p>
        <p class="page-hero__lede">
          Work directly with Sonia Sarao to connect AI opportunities with business priorities,
          executive leadership and the capabilities of your internal teams.
        </p>
        <p class="page-hero__audience">
          For founders, CEOs and leadership teams in space, defense and complex technology
          businesses.
        </p>
        <div class="page-hero__cta">
          <Button variant="primary" href="#start" size="large" track="advisory_hero_start">
            Start a conversation
          </Button>
          <Button variant="secondary" href="#advisor" size="large">Meet the advisor</Button>
        </div>
      </div>
    </section>

    <!-- The focus areas, with product, growth and leadership as supporting strength. -->
    <section class="page-section page-section--alt" aria-labelledby="work-heading">
      <div class="container">
        <SectionHeader label="Focus areas" align="left" />
        <h2 id="work-heading" class="page-section__heading">Where AI meets the business.</h2>

        <div class="focus-grid">
          {focusAreas.map((area) => (
            <article class="focus">
              <h3 class="focus__title">{area.title}</h3>
              <p class="focus__body">{area.body}</p>
            </article>
          ))}
        </div>

        <div class="experience">
          <h3 class="experience__title">{supportingExperience.title}</h3>
          <div class="experience__body">
            {supportingExperience.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </div>
    </section>

    <section class="page-section" id="advisor" aria-labelledby="advisor-heading">
      <div class="container profile">
        <div class="profile__side">
          <TeamAvatar member={sonia.slug} class="profile__photo" />
          <h2 id="advisor-heading" class="profile__name">{sonia.name}</h2>
          <p class="profile__role">{sonia.role}</p>
          <p class="profile__strengths">{sonia.strengths}</p>
          <a
            class="profile__link"
            href={sonia.linkedIn}
            target="_blank"
            rel="noopener noreferrer"
          >
            Sonia on LinkedIn <span aria-hidden="true">&nearr;</span>
          </a>
        </div>

        <div class="profile__main">
          {sonia.bio.map((paragraph) => <p class="profile__bio">{paragraph}</p>)}

          <ul class="profile__proof">
            {sonia.proof.map((item) => <li>{item}</li>)}
          </ul>

          <p class="profile__depth">{sonia.depth}</p>

          <p class="profile__also">
            Investing questions go to Cammie Clay, who leads our investing.{' '}
            <a href="/investing">How we invest <span aria-hidden="true">&rarr;</span></a>
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="page-section page-section--alt" aria-labelledby="how-heading">
      <div class="container work-split">
        <div class="work-split__main">
          <SectionHeader label="How we work" align="left" />
          <h2 id="how-heading" class="page-section__heading">
            Decisions, carried into practice.
          </h2>
          <p class="page-section__sub">
            Ongoing executive advisory and fractional leadership engagements, shaped around your
            company’s priorities.
          </p>
          <p class="page-section__sub">
            Regular working sessions and direct access provide continuity as decisions move into
            practice. Sonia brings an ongoing outside perspective on AI while working alongside your
            leadership and internal teams.
          </p>
        </div>

        <aside class="fit-card">
          <h3 class="fit-card__title">Is this a fit?</h3>
          <p>
            For founders, CEOs and leadership teams in space, defense and complex technology
            businesses.
          </p>
          <p>The scope, cadence and fee reflect the priorities and level of involvement.</p>
          <Button variant="primary" href="#start" size="large" track="advisory_fit_start">
            Start a conversation
          </Button>
        </aside>
      </div>
    </section>

    <!-- Intake -->
    <section class="page-section" id="start" aria-labelledby="start-heading">
      <div class="container">
        <SectionHeader label="Start a conversation" align="left" />
        <h2 id="start-heading" class="page-section__heading">Tell us about the company</h2>
        <p class="page-section__sub">
          A few lines is enough. We will reply within a few days.
        </p>

        <div
          id="form-success"
          class="form-banner form-banner--success"
          role="status"
          tabindex="-1"
          hidden
        >
          Thanks for getting in touch. We will reply within a few days.
        </div>

        <div id="form-error" class="form-banner form-banner--error" role="alert" hidden>
          Please complete the highlighted fields.
        </div>

        <form id="request-form" class="contact-form" novalidate aria-label="Start a conversation">
          <Field id="advisory-name" name="name" label="Name" type="text" required />
          <Field id="advisory-email" name="email" label="Email" type="email" required />
          <Field
            id="advisory-company-name"
            name="company_name"
            label="Company name"
            type="text"
            optional
          />
          <Field
            id="advisory-stage"
            name="stage"
            label="Company stage"
            type="select"
            optional
            options={advisoryStageOptions}
          />
          <Field
            id="advisory-focus"
            name="focus"
            label="What you are working through"
            type="select"
            optional
            options={advisoryFocusOptions}
          />
          <Field
            id="advisory-message"
            name="message"
            label="What does the company do, and what decision is in front of you"
            type="textarea"
            required
            placeholder="What the company does, where AI fits today, and the decision you are working through."
          />
          <Field
            id="advisory-link"
            name="link"
            label="Website or LinkedIn"
            type="url"
            optional
            placeholder="yourcompany.com"
          />

          <input
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            class="contact-form__hp"
            aria-hidden="true"
          />

          <Button type="submit" variant="primary" size="large">Send</Button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* "How we work": copy on the left, the fit/commercial aside on the
     right, so the money question sits next to the description of the work
     rather than buried under it. */
  .work-split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-8);
    align-items: start;
  }

  .fit-card {
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .fit-card__title {
    font-size: var(--text-lg);
  }

  .fit-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* Spam trap: kept off screen so only bots fill it in. */
  .contact-form__hp {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    opacity: 0;
    pointer-events: none;
  }

  .profile__also {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .profile__also a {
    font-weight: 600;
    text-decoration: none;
  }

  .page-hero__tagline {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-accent);
  }

  .page-hero__audience {
    margin-top: var(--space-4);
    max-width: var(--readw);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .focus {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 2px solid var(--color-text);
  }

  .focus__title {
    font-size: var(--text-lg);
  }

  .focus__body {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .experience {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-6);
  }

  .experience__title {
    font-size: var(--text-md);
    font-weight: 600;
  }

  .experience__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--readw);
  }

  .experience__body p {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  @media (max-width: 880px) {
    .focus-grid,
    .experience,
    .work-split {
      grid-template-columns: 1fr;
    }

    .work-split {
      gap: var(--space-7);
    }
  }
</style>

<script>
  import { normalizeUrl, isValidWebUrl, INVALID_URL_MESSAGE } from '../scripts/url';

  const form = document.getElementById('request-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('form-success');
  const errorBanner = document.getElementById('form-error');

  const fieldLabels: Record<string, string> = {
    name: 'Name',
    email: 'Email',
    message: 'What does the company do, and what decision is in front of you',
    link: 'Website or LinkedIn',
  };

  const showFieldError = (name: string, message: string) => {
    const wrapper = form?.querySelector(`[data-field="${name}"]`);
    const control = wrapper?.querySelector<HTMLElement>('.field__control');
    const errorEl = wrapper?.querySelector<HTMLElement>('.field__error');
    if (!wrapper || !control || !errorEl) return;
    wrapper.classList.add('field--invalid');
    control.setAttribute('aria-invalid', 'true');
    errorEl.textContent = message;
    errorEl.hidden = false;
  };

  const clearFieldErrors = () => {
    form?.querySelectorAll('[data-field]').forEach((wrapper) => {
      wrapper.classList.remove('field--invalid');
      const control = wrapper.querySelector<HTMLElement>('.field__control');
      const errorEl = wrapper.querySelector<HTMLElement>('.field__error');
      control?.removeAttribute('aria-invalid');
      if (errorEl) {
        errorEl.textContent = '';
        errorEl.hidden = true;
      }
    });
  };

  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearFieldErrors();
      successBanner?.setAttribute('hidden', '');
      errorBanner?.setAttribute('hidden', '');

      const data = new FormData(form);
      let valid = true;

      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const companyName = String(data.get('company_name') ?? '').trim();
      const stage = String(data.get('stage') ?? '').trim();
      const focus = String(data.get('focus') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const link = normalizeUrl(String(data.get('link') ?? ''));

      if (!name) {
        showFieldError('name', `${fieldLabels.name} is required.`);
        valid = false;
      }

      if (!email) {
        showFieldError('email', `${fieldLabels.email} is required.`);
        valid = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showFieldError('email', 'Enter a valid email address.');
        valid = false;
      }

      if (!message) {
        showFieldError('message', 'Please tell us what decision you are facing.');
        valid = false;
      }

      if (link && !isValidWebUrl(link)) {
        showFieldError('link', INVALID_URL_MESSAGE);
        valid = false;
      }

      if (!valid) {
        errorBanner?.removeAttribute('hidden');
        const firstInvalid = form.querySelector<HTMLElement>('.field--invalid .field__control');
        firstInvalid?.focus();
        return;
      }

      const originalLabel = submitButton?.textContent;
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending...';
      }

      try {
        const res = await fetch('/api/advisory', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            company_name: companyName,
            stage,
            focus,
            message,
            link,
          }),
        });
        const result = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
          errors?: Record<string, string>;
        };

        if (!res.ok || !result.ok) {
          if (result.errors) {
            for (const [field, msg] of Object.entries(result.errors)) {
              showFieldError(field, msg);
            }
          }
          if (errorBanner) {
            errorBanner.textContent =
              result.error ??
              (result.errors
                ? 'Please complete the highlighted fields.'
                : 'Something went wrong. Please try again.');
            errorBanner.removeAttribute('hidden');
          }
          const firstInvalid = form.querySelector<HTMLElement>('.field--invalid .field__control');
          firstInvalid?.focus();
          return;
        }

        form.reset();
        successBanner?.removeAttribute('hidden');
        successBanner?.focus();
        window.faiTrack?.('advisory_submitted', { stage, focus });
      } catch {
        if (errorBanner) {
          errorBanner.textContent = 'Network error. Please try again.';
          errorBanner.removeAttribute('hidden');
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalLabel ?? 'Send';
        }
      }
    });
  }
</script>
