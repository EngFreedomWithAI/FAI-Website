---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Field from '../components/Field.astro';
import TeamAvatar from '../components/TeamAvatar.astro';
import { advisorBySlug } from '../data/advisors';
import { workAreas } from '../data/engagements';
import { advisoryFocusOptions, advisoryStageOptions } from '../data/contact-form';
import '../styles/content-pages.css';

const pageTitle = 'Advisory | Freedom with AI';
const pageDescription =
  'Advisory for space and deep-tech founders with Sonia Sarao: first customers, product strategy, go-to-market and fundraising, from someone who has built and sold enterprise technology.';

const sonia = advisorBySlug('sonia');

const advisorySchema = {
  '@type': 'Service',
  name: 'Founder Advisory for Space and Deep-Tech Companies',
  description: pageDescription,
  provider: { '@id': `${Astro.site?.origin ?? 'https://freedomwith.ai'}/#organization` },
  areaServed: 'Worldwide',
  serviceType: [
    'Commercialization strategy',
    'Product strategy',
    'Go-to-market strategy',
    'Fundraising strategy',
    'Diligence readiness',
  ],
};
---

<Base title={pageTitle} description={pageDescription} schema={advisorySchema}>
  <Nav />

  <main id="main-content">
    <section class="page-hero" aria-labelledby="advisory-heading">
      <div class="container">
        <SectionHeader label="Advisory" align="left" />
        <h1 id="advisory-heading" class="page-hero__title">
          Advisory for founders building in space.
        </h1>
        <p class="page-hero__lede">
          We work with space and deep-tech founders on the decisions that turn a working
          technology into a business: who buys it, what to build next, how to sell it and how to
          raise.
        </p>
        <div class="page-hero__cta">
          <Button variant="primary" href="#start" size="large" track="advisory_hero_start">
            Start a conversation
          </Button>
          <Button variant="secondary" href="#advisor" size="large">Meet the advisor</Button>
        </div>
      </div>
    </section>

    <!-- The work, by problem -->
    <section class="page-section page-section--alt" aria-labelledby="work-heading">
      <div class="container">
        <SectionHeader label="Where we help" align="left" />
        <h2 id="work-heading" class="page-section__heading">Four problems between a breakthrough and a business.</h2>
        <p class="page-section__sub">
          They show up most sharply in space, and in any company where the technology is hard, the
          buyers are complex and the timelines are long.
        </p>

        <div class="work-grid">
          {workAreas.map((area) => (
            <article class="work">
              <h3 class="work__title">{area.title}</h3>
              <p class="work__body">{area.body}</p>
              <ul class="work__list">
                {area.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section" id="advisor" aria-labelledby="advisor-heading">
      <div class="container profile">
        <div class="profile__side">
          <TeamAvatar member={sonia.slug} class="profile__photo" />
          <h2 id="advisor-heading" class="profile__name">{sonia.name}</h2>
          <p class="profile__role">{sonia.role}</p>
          <p class="profile__strengths">{sonia.strengths}</p>
          <a
            class="profile__link"
            href={sonia.linkedIn}
            target="_blank"
            rel="noopener noreferrer"
          >
            Sonia on LinkedIn <span aria-hidden="true">&nearr;</span>
          </a>
        </div>

        <div class="profile__main">
          {sonia.bio.map((paragraph) => <p class="profile__bio">{paragraph}</p>)}

          <ul class="profile__proof">
            {sonia.proof.map((item) => <li>{item}</li>)}
          </ul>

          <p class="profile__depth">{sonia.depth}</p>

          <p class="profile__also">
            Investing questions go to Cammie Clay, who leads our investing.{' '}
            <a href="/investing">How we invest <span aria-hidden="true">&rarr;</span></a>
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="page-section page-section--alt" aria-labelledby="how-heading">
      <div class="container work-split">
        <div class="work-split__main">
          <SectionHeader label="How engagements work" align="left" />
          <h2 id="how-heading" class="page-section__heading">
            Decisions, carried through.
          </h2>
          <p class="page-section__sub">
            Engagements are shaped around the company’s priorities and evolve as decisions are made
            and new constraints emerge.
          </p>

          <ul class="check-list">
            <li>
              A company-level perspective across market, product, go-to-market and fundraising
            </li>
            <li>Regular working sessions focused on the decisions in motion</li>
            <li>Direct access as questions surface between sessions</li>
            <li>Continuity from decision through execution</li>
          </ul>
        </div>

        <aside class="fit-card">
          <h3 class="fit-card__title">Is this a fit?</h3>
          <p>
            Best for founders in space, physical AI and deep tech with a working technology and a
            commercial decision in front of them.
          </p>
          <p>
            We also take a small number of FinTech, B2B software and life sciences engagements.
          </p>
          <p>
            We begin with a three- or six-month engagement. Scope and fee reflect the priorities
            and level of involvement.
          </p>
          <Button variant="primary" href="#start" size="large" track="advisory_fit_start">
            Start a conversation
          </Button>
        </aside>
      </div>
    </section>

    <!-- Intake -->
    <section class="page-section" id="start" aria-labelledby="start-heading">
      <div class="container">
        <SectionHeader label="Start a conversation" align="left" />
        <h2 id="start-heading" class="page-section__heading">Tell us about the company</h2>
        <p class="page-section__sub">
          A few lines is enough. We will reply within a few days.
        </p>

        <div
          id="form-success"
          class="form-banner form-banner--success"
          role="status"
          tabindex="-1"
          hidden
        >
          Thanks for getting in touch. We will reply within a few days.
        </div>

        <div id="form-error" class="form-banner form-banner--error" role="alert" hidden>
          Please complete the highlighted fields.
        </div>

        <form id="request-form" class="contact-form" novalidate aria-label="Start a conversation">
          <Field id="advisory-name" name="name" label="Name" type="text" required />
          <Field id="advisory-email" name="email" label="Email" type="email" required />
          <Field
            id="advisory-company-name"
            name="company_name"
            label="Company name"
            type="text"
            optional
          />
          <Field
            id="advisory-stage"
            name="stage"
            label="Stage"
            type="select"
            optional
            options={advisoryStageOptions}
          />
          <Field
            id="advisory-focus"
            name="focus"
            label="What you are working through"
            type="select"
            optional
            options={advisoryFocusOptions}
          />
          <Field
            id="advisory-message"
            name="message"
            label="What does the company do, and what decision is in front of you"
            type="textarea"
            required
            placeholder="What you are building, who it is for, and the call you are trying to make in the next six months."
          />
          <Field
            id="advisory-link"
            name="link"
            label="Website, deck or LinkedIn"
            type="url"
            optional
            placeholder="yourcompany.com"
          />

          <input
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            class="contact-form__hp"
            aria-hidden="true"
          />

          <Button type="submit" variant="primary" size="large">Send</Button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* "How engagements work": copy on the left, the fit/commercial aside on the
     right, so the money question sits next to the description of the work
     rather than buried under it. */
  .work-split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-8);
    align-items: start;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--readw);
  }

  .check-list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  .check-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 12px;
    height: 1px;
    background: var(--color-accent);
  }

  .fit-card {
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .fit-card__title {
    font-size: var(--text-lg);
  }

  .fit-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .profile__also {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .profile__also a {
    font-weight: 600;
    text-decoration: none;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .work {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 2px solid var(--color-text);
  }

  .work__title {
    font-size: var(--text-lg);
  }

  .work__body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .work__list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .work__list li {
    position: relative;
    padding-left: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .work__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 1px;
    background: var(--color-text-subtle);
  }

  @media (max-width: 880px) {
    .work-grid,
    .work-split {
      grid-template-columns: 1fr;
    }

    .work-split {
      gap: var(--space-7);
    }
  }
</style>

<script>
  import { normalizeUrl, isValidWebUrl, INVALID_URL_MESSAGE } from '../scripts/url';

  const form = document.getElementById('request-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('form-success');
  const errorBanner = document.getElementById('form-error');

  const fieldLabels: Record<string, string> = {
    name: 'Name',
    email: 'Email',
    message: 'What does the company do, and what decision is in front of you',
    link: 'Website, deck or LinkedIn',
  };

  const showFieldError = (name: string, message: string) => {
    const wrapper = form?.querySelector(`[data-field="${name}"]`);
    const control = wrapper?.querySelector<HTMLElement>('.field__control');
    const errorEl = wrapper?.querySelector<HTMLElement>('.field__error');
    if (!wrapper || !control || !errorEl) return;
    wrapper.classList.add('field--invalid');
    control.setAttribute('aria-invalid', 'true');
    errorEl.textContent = message;
    errorEl.hidden = false;
  };

  const clearFieldErrors = () => {
    form?.querySelectorAll('[data-field]').forEach((wrapper) => {
      wrapper.classList.remove('field--invalid');
      const control = wrapper.querySelector<HTMLElement>('.field__control');
      const errorEl = wrapper.querySelector<HTMLElement>('.field__error');
      control?.removeAttribute('aria-invalid');
      if (errorEl) {
        errorEl.textContent = '';
        errorEl.hidden = true;
      }
    });
  };

  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearFieldErrors();
      successBanner?.setAttribute('hidden', '');
      errorBanner?.setAttribute('hidden', '');

      const data = new FormData(form);
      let valid = true;

      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const companyName = String(data.get('company_name') ?? '').trim();
      const stage = String(data.get('stage') ?? '').trim();
      const focus = String(data.get('focus') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const link = normalizeUrl(String(data.get('link') ?? ''));

      if (!name) {
        showFieldError('name', `${fieldLabels.name} is required.`);
        valid = false;
      }

      if (!email) {
        showFieldError('email', `${fieldLabels.email} is required.`);
        valid = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showFieldError('email', 'Enter a valid email address.');
        valid = false;
      }

      if (!message) {
        showFieldError('message', 'Please tell us what decision you are facing.');
        valid = false;
      }

      if (link && !isValidWebUrl(link)) {
        showFieldError('link', INVALID_URL_MESSAGE);
        valid = false;
      }

      if (!valid) {
        errorBanner?.removeAttribute('hidden');
        const firstInvalid = form.querySelector<HTMLElement>('.field--invalid .field__control');
        firstInvalid?.focus();
        return;
      }

      const originalLabel = submitButton?.textContent;
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending...';
      }

      try {
        const res = await fetch('/api/advisory', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            company_name: companyName,
            stage,
            focus,
            message,
            link,
          }),
        });
        const result = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
          errors?: Record<string, string>;
        };

        if (!res.ok || !result.ok) {
          if (result.errors) {
            for (const [field, msg] of Object.entries(result.errors)) {
              showFieldError(field, msg);
            }
          }
          if (errorBanner) {
            errorBanner.textContent =
              result.error ??
              (result.errors
                ? 'Please complete the highlighted fields.'
                : 'Something went wrong. Please try again.');
            errorBanner.removeAttribute('hidden');
          }
          const firstInvalid = form.querySelector<HTMLElement>('.field--invalid .field__control');
          firstInvalid?.focus();
          return;
        }

        form.reset();
        successBanner?.removeAttribute('hidden');
        successBanner?.focus();
        window.faiTrack?.('advisory_submitted', { stage, focus });
      } catch {
        if (errorBanner) {
          errorBanner.textContent = 'Network error. Please try again.';
          errorBanner.removeAttribute('hidden');
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalLabel ?? 'Send';
        }
      }
    });
  }
</script>
