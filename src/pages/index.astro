---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import CtaStrip from '../components/CtaStrip.astro';
import TeamAvatar from '../components/TeamAvatar.astro';
import ArcDiagram from '../components/ArcDiagram.astro';
import { site } from '../config/site';
import { advisorBySlug } from '../data/advisors';
import { focusAreas, inflectionPoints, engagementExamples, proofPoints } from '../data/engagements';
import { arcLine, investingBoundary, participation, thesisPieces } from '../data/thesis';

const pageTitle = 'Build AI capability from within | Freedom with AI';
const pageDescription = site.summary;

const sonia = advisorBySlug('sonia');
const cammie = advisorBySlug('cammie');
const build = participation.find((mode) => mode.mode === 'Build');
const featuredPiece = thesisPieces[0];
---

<Base title={pageTitle} description={pageDescription}>
  <Nav />

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container">
        <p class="eyebrow">Build. Advise. Invest.</p>
        <h1 id="hero-heading" class="hero__title">Build AI capability from within.</h1>

        <p class="hero__sub">
          We advise founders, CEOs and leadership teams in space, defense and complex technology
          businesses on AI strategy, adoption and company growth.
        </p>
        <p class="hero__sub hero__sub--more">
          Our work combines executive experience, practical AI product building and an ongoing outside
          perspective, helping leaders set direction and their teams put it into practice.
        </p>
        <p class="hero__sub hero__sub--more">
          We also invest our own capital in space and physical AI companies.
        </p>

        <div class="cta-row">
          <Button
            variant="primary"
            href={site.cta.href}
            size="large"
            track="hero_advisory"
          >
            Start a conversation
          </Button>
        </div>
      </div>
    </section>

    <!-- Proof strip: checkable facts only, no client or portfolio names. -->
    <section class="proof" aria-label="Experience at a glance">
      <div class="container">
        <ul class="proof__list">
          {proofPoints.map((point) => (
            <li class="proof__item">
              <span class="proof__figure">{point.figure}</span>
              <span class="proof__label">{point.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- The advisory offer, ahead of the thesis, so a prospective client sees how to work with us first. -->
    <section class="block block--alt" aria-labelledby="advise-heading">
      <div class="container">
        <p class="eyebrow">Advise</p>
        <h2 id="advise-heading" class="block__title">Executive advisory for AI strategy.</h2>
        <p class="block__sub">
          Work directly with {sonia.name} to connect AI opportunities with business priorities,
          executive leadership and the capabilities of your internal teams.
        </p>

        <ul class="focus">
          {focusAreas.map((area) => (
            <li class="focus__item">
              <h3 class="focus__title">{area.title}</h3>
              <p class="focus__body">{area.body}</p>
            </li>
          ))}
        </ul>

        <a class="block__link" href="/advisory">How advisory works <span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>

    <!-- One firm, complementary experience: both partner profiles, side by side. -->
    <section class="block" id="team" aria-labelledby="team-heading">
      <div class="container">
        <p id="team-heading" class="eyebrow">Who you work with</p>

        <div class="paths">
          {[sonia, cammie].map((partner) => (
            <article class="path">
              <div class="path__head">
                <TeamAvatar member={partner.slug} class="path__photo" />
                <div>
                  <h3 class="path__name">{partner.name}</h3>
                  <p class="path__role">{partner.role}</p>
                </div>
              </div>
              <p class="path__lede">{partner.lede}</p>
              {partner.summary.map((paragraph) => <p class="path__summary">{paragraph}</p>)}
              <a class="path__link" href={partner.linkedIn} target="_blank" rel="noopener noreferrer">
                {partner.name.split(' ')[0]} on LinkedIn <span aria-hidden="true">&nearr;</span>
              </a>
            </article>
          ))}
        </div>

        {build && (
          <div class="build">
            <p class="build__mode">Build</p>
            <p class="build__body">{build.body}</p>
            {build.link && (
              <a class="build__link" href={build.link.href} target="_blank" rel="noopener noreferrer">
                {build.link.label} <span aria-hidden="true">&nearr;</span>
              </a>
            )}
          </div>
        )}

        <p class="paths__note">{investingBoundary}</p>
      </div>
    </section>

    <section class="thesis on-dark" aria-labelledby="thesis-heading">
      <div class="container">
        <p class="eyebrow">Our thesis</p>
        <h2 id="thesis-heading" class="thesis__title">
          AI is leaving the screen. Space is its hardest test.
        </h2>
        <p class="thesis__lede">
          The money followed software for a decade. Now it is buying atoms: chips, data centers and
          power. Next it drives them, in robots, vehicles and machines that act in the world. Space is
          where every layer of that stack runs under the hardest constraints, and it is a focus of our
          investing and our advising.
        </p>

        <div class="thesis__arc">
          <ArcDiagram />
        </div>

        <div class="thesis__foot">
          <p class="thesis__limit">{arcLine}</p>
          <div class="thesis__links">
            <a href="/thesis">Read the full thesis <span aria-hidden="true">&rarr;</span></a>
            {featuredPiece && (
              <a href={featuredPiece.href}>
                {featuredPiece.title}, by {featuredPiece.author}{' '}
                <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="block block--alt" aria-labelledby="when-heading">
      <div class="container">
        <p class="eyebrow">When leaders bring us in</p>
        <h2 id="when-heading" class="block__title">The decision is rarely about the technology alone.</h2>

        <ul class="moments">
          {inflectionPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="block" aria-labelledby="proof-heading">
      <div class="container">
        <p class="eyebrow">Selected advisory work</p>
        <h2 id="proof-heading" class="block__title">Recent problems we have worked through.</h2>

        <ul class="examples">
          {engagementExamples.map((example) => (
            <li class="example">
              <p class="example__meta">
                <span class="example__sector">{example.sector}</span>
              </p>
              <p class="example__body">{example.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaStrip>
      <span slot="heading">Tell us what decision is in front of you.</span>
      <Button slot="actions" variant="primary" href={site.cta.href} size="large" track="footer_advisory">
        Start a conversation
      </Button>
    </CtaStrip>
  </main>

  <Footer />
</Base>

<style>
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .block {
    padding-block: clamp(56px, 8vw, 104px);
  }

  .block--alt {
    background: var(--color-bg-alt);
    border-block: 1px solid var(--color-border);
  }

  .block__title {
    margin-top: var(--space-3);
    max-width: 22ch;
  }

  .block__sub {
    margin-top: var(--space-4);
    max-width: 62ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .block__link {
    display: inline-block;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* ---------- hero ---------- */
  .hero {
    padding-block: clamp(72px, 12vw, 148px) clamp(48px, 6vw, 72px);
  }

  .hero .eyebrow {
    color: var(--color-accent);
  }

  .hero__title {
    margin-top: var(--space-3);
    max-width: 18ch;
  }

  .hero__sub {
    margin-top: var(--space-6);
    max-width: 60ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .hero__sub--more {
    margin-top: var(--space-3);
  }

  /* ---------- advisory focus ---------- */
  .focus {
    list-style: none;
    padding: 0;
    margin-top: var(--space-7);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .focus__item {
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-accent);
  }

  .focus__title {
    font-size: var(--text-md);
    font-weight: 600;
  }

  .focus__body {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  /* ---------- proof strip ---------- */
  .proof {
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .proof__list {
    list-style: none;
    margin: 0;
    padding: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .proof__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .proof__figure {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-text);
  }

  .proof__label {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  /* ---------- thesis ---------- */
  .thesis {
    padding-block: clamp(64px, 9vw, 112px);
    background: #020812;
  }

  .thesis__title {
    margin-top: var(--space-3);
    max-width: 22ch;
  }

  .thesis__lede {
    margin-top: var(--space-5);
    max-width: 64ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .thesis__arc {
    margin-top: clamp(48px, 6vw, 72px);
  }

  .thesis__foot {
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .thesis__limit {
    max-width: var(--readw);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .thesis__links {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .thesis__links a {
    text-decoration: none;
  }

  /* ---------- team ---------- */
  .paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-top: var(--space-5);
  }

  .path {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--r);
  }

  .path__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .path :global(.path__photo) {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  .path__name {
    font-size: var(--text-lg);
  }

  .path__role {
    margin-top: 2px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .path__lede {
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  .path__summary {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .path__link {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .build {
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-6);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
  }

  .build__mode {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .build__body {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 78ch;
  }

  .build__link {
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .paths__note {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  /* ---------- moments ---------- */
  .moments {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .moments li {
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  /* ---------- examples ---------- */
  .examples {
    list-style: none;
    padding: 0;
    margin-top: var(--space-7);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .example {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
  }

  .example__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .example__sector {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: var(--r-sm);
  }

  .example__sector {
    background: var(--blue-soft);
    color: var(--color-accent);
  }

  .example__body {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 1040px) {
    .proof__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 880px) {
    .paths,
    .examples,
    .moments,
    .focus {
      grid-template-columns: 1fr;
    }

    .build {
      grid-template-columns: 1fr;
    }

    .hero__title {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .proof__list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
