---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import CtaStrip from '../components/CtaStrip.astro';
import TeamAvatar from '../components/TeamAvatar.astro';
import ArcDiagram from '../components/ArcDiagram.astro';
import { site } from '../config/site';
import { advisorBySlug } from '../data/advisors';
import { inflectionPoints, engagementExamples, proofPoints } from '../data/engagements';
import { arcLine, investingBoundary, participation, thesisPieces } from '../data/thesis';

const pageTitle = 'Advising and investing in space founders | Freedom with AI';
const pageDescription = site.summary;

const sonia = advisorBySlug('sonia');
const cammie = advisorBySlug('cammie');
const build = participation.find((mode) => mode.mode === 'Build');
const featuredPiece = thesisPieces[0];
---

<Base title={pageTitle} description={pageDescription}>
  <Nav />

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container">
        <p class="eyebrow">Build. Advise. Invest.</p>
        <h1 id="hero-heading" class="hero__title">
          You’ve built the technology. Now build the company.
        </h1>

        <p class="hero__sub">
          We accelerate entrepreneurs building in space and physical AI. We advise founders on turning
          a working technology into a business, and invest our own capital in companies we believe in.
        </p>

        <div class="cta-row">
          <Button
            variant="primary"
            href={site.cta.href}
            size="large"
            track="hero_advisory"
          >
            Start a conversation
          </Button>
          <Button variant="secondary" href="/thesis" size="large" track="hero_thesis">
            Read our thesis
          </Button>
        </div>
      </div>
    </section>

    <!-- Proof strip: checkable facts only, no client or portfolio names. -->
    <section class="proof" aria-label="Experience at a glance">
      <div class="container">
        <ul class="proof__list">
          {proofPoints.map((point) => (
            <li class="proof__item">
              <span class="proof__figure">{point.figure}</span>
              <span class="proof__label">{point.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="thesis on-dark" aria-labelledby="thesis-heading">
      <div class="container">
        <p class="eyebrow">Our thesis</p>
        <h2 id="thesis-heading" class="thesis__title">
          AI is leaving the screen. Space is its hardest test.
        </h2>
        <p class="thesis__lede">
          The money followed software for a decade. Now it is buying atoms: chips, data centers and
          power. Next it drives them, in robots, vehicles and machines that act in the world. Space is
          where every layer of that stack runs under the hardest constraints, and where we focus.
        </p>

        <div class="thesis__arc">
          <ArcDiagram />
        </div>

        <div class="thesis__foot">
          <p class="thesis__limit">{arcLine}</p>
          <div class="thesis__links">
            <a href="/thesis">Read the full thesis <span aria-hidden="true">&rarr;</span></a>
            {featuredPiece && (
              <a href={featuredPiece.href}>
                {featuredPiece.title}, by {featuredPiece.author}{' '}
                <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Two clear paths: advisory with Sonia, investing with Cammie. -->
    <section class="block" id="team" aria-labelledby="paths-heading">
      <div class="container">
        <p class="eyebrow">How we work with founders</p>
        <h2 id="paths-heading" class="block__title">Two partners. Two ways in.</h2>

        <div class="paths">
          <article class="path">
            <p class="path__mode">Advise</p>
            <div class="path__head">
              <TeamAvatar member={sonia.slug} class="path__photo" />
              <div>
                <h3 class="path__name">{sonia.name}</h3>
                <p class="path__role">{sonia.role}</p>
              </div>
            </div>
            <p class="path__lede">{sonia.lede}</p>
            <div class="path__actions">
              <Button variant="primary" href={site.cta.href} track="path_advisory">
                Start a conversation
              </Button>
              <a class="path__link" href="/advisory">How advisory works <span aria-hidden="true">&rarr;</span></a>
            </div>
          </article>

          <article class="path">
            <p class="path__mode">Invest</p>
            <div class="path__head">
              <TeamAvatar member={cammie.slug} class="path__photo" />
              <div>
                <h3 class="path__name">{cammie.name}</h3>
                <p class="path__role">{cammie.role}</p>
              </div>
            </div>
            <p class="path__lede">{cammie.lede}</p>
            <div class="path__actions">
              <Button variant="secondary" href="/investing" track="path_investing">
                How we invest
              </Button>
            </div>
          </article>
        </div>

        {build && (
          <div class="build">
            <p class="build__mode">Build</p>
            <p class="build__body">{build.body}</p>
            {build.link && (
              <a class="build__link" href={build.link.href} target="_blank" rel="noopener noreferrer">
                {build.link.label} <span aria-hidden="true">&nearr;</span>
              </a>
            )}
          </div>
        )}

        <p class="paths__note">{investingBoundary}</p>
      </div>
    </section>

    <section class="block block--alt" aria-labelledby="when-heading">
      <div class="container">
        <p class="eyebrow">When founders bring us in</p>
        <h2 id="when-heading" class="block__title">The hard part is no longer the technology.</h2>

        <ul class="moments">
          {inflectionPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>

        <p class="honest">
          We bring operating, product and commercial experience, not aerospace engineering. You know
          the physics. We help with who buys it, and how.
        </p>
      </div>
    </section>

    <section class="block" aria-labelledby="proof-heading">
      <div class="container">
        <p class="eyebrow">Selected advisory work</p>
        <h2 id="proof-heading" class="block__title">Recent problems we have worked through.</h2>

        <ul class="examples">
          {engagementExamples.map((example) => (
            <li class="example">
              <p class="example__meta">
                <span class="example__stage">{example.stage}</span>
                <span class="example__sector">{example.sector}</span>
              </p>
              <p class="example__body">{example.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaStrip>
      <span slot="heading">Tell us what decision is in front of you.</span>
      <Button slot="actions" variant="primary" href={site.cta.href} size="large" track="footer_advisory">
        Start a conversation
      </Button>
    </CtaStrip>
  </main>

  <Footer />
</Base>

<style>
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .block {
    padding-block: clamp(56px, 8vw, 104px);
  }

  .block--alt {
    background: var(--color-bg-alt);
    border-block: 1px solid var(--color-border);
  }

  .block__title {
    margin-top: var(--space-3);
    max-width: 22ch;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* ---------- hero ---------- */
  .hero {
    padding-block: clamp(72px, 12vw, 148px) clamp(48px, 6vw, 72px);
  }

  .hero .eyebrow {
    color: var(--color-accent);
  }

  .hero__title {
    margin-top: var(--space-3);
    max-width: 18ch;
  }

  .hero__sub {
    margin-top: var(--space-6);
    max-width: 60ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  /* ---------- proof strip ---------- */
  .proof {
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .proof__list {
    list-style: none;
    margin: 0;
    padding: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .proof__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .proof__figure {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-text);
  }

  .proof__label {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  /* ---------- thesis ---------- */
  .thesis {
    padding-block: clamp(64px, 9vw, 112px);
    background: #020812;
  }

  .thesis__title {
    margin-top: var(--space-3);
    max-width: 22ch;
  }

  .thesis__lede {
    margin-top: var(--space-5);
    max-width: 64ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .thesis__arc {
    margin-top: clamp(48px, 6vw, 72px);
  }

  .thesis__foot {
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .thesis__limit {
    max-width: var(--readw);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .thesis__links {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .thesis__links a {
    text-decoration: none;
  }

  /* ---------- paths ---------- */
  .paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .path {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--r);
  }

  .path__mode {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .path__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .path :global(.path__photo) {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  .path__name {
    font-size: var(--text-lg);
  }

  .path__role {
    margin-top: 2px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .path__lede {
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--color-text);
    min-height: 5.1rem;
  }

  .path__actions {
    margin-top: auto;
    padding-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .path__link {
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .build {
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-6);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
  }

  .build__mode {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .build__body {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 78ch;
  }

  .build__link {
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .paths__note {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  /* ---------- moments ---------- */
  .moments {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .moments li {
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  .honest {
    margin-top: var(--space-6);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    max-width: 62ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  /* ---------- examples ---------- */
  .examples {
    list-style: none;
    padding: 0;
    margin-top: var(--space-7);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .example {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
  }

  .example__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .example__stage,
  .example__sector {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: var(--r-sm);
  }

  .example__stage {
    background: var(--blue-soft);
    color: var(--color-accent);
  }

  .example__sector {
    background: var(--paper-3);
    color: var(--color-text-muted);
  }

  .example__body {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 1040px) {
    .proof__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 880px) {
    .paths,
    .examples,
    .moments {
      grid-template-columns: 1fr;
    }

    .build {
      grid-template-columns: 1fr;
    }

    .path__lede {
      min-height: 0;
    }

    .hero__title {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .proof__list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
