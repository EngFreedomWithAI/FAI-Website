---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import CtaStrip from '../components/CtaStrip.astro';
import TeamAvatar from '../components/TeamAvatar.astro';
import { site } from '../config/site';
import { advisors } from '../data/advisors';
import { inflectionPoints, engagementExamples } from '../data/engagements';

const pageTitle = 'Advisory for founders leveraging AI | Freedom with AI';
const pageDescription = site.summary;
const homepageExamples = [engagementExamples[1], engagementExamples[2]];
---

<Base title={pageTitle} description={pageDescription}>
  <Nav />

  <main id="main-content">
    <!-- Hero: typographic. The old illustrated hero showed figures escaping an
         office, which was the retired positioning drawn as art. -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container">
        <p class="eyebrow">Advisory for founders leveraging AI</p>
        <h1 id="hero-heading" class="hero__title">
          When the next move is not obvious.
        </h1>

        <p class="hero__sub">
          Work directly with Sonia or Cammie on the strategic decisions involved in building and
          growing a company, with added depth across product, technology, growth, regulation and risk.
        </p>

        <div class="cta-row">
          <Button variant="primary" href={site.cta.href} size="large">
            {site.cta.label}
          </Button>
          <Button variant="secondary" href="#advisors" size="large">Meet the advisors</Button>
        </div>

        <p class="hero__fit">
          We work across industries, especially where products, buying decisions, operations or
          regulation are complex.
        </p>
      </div>
    </section>

    <section class="block block--alt" id="advisors" aria-labelledby="advisors-heading">
      <div class="container">
        <h2 id="advisors-heading" class="block__title">Advisors</h2>

        <div class="advisor-grid">
          {advisors.map((advisor) => (
            <article class="advisor">
              <div class="advisor__head">
                <TeamAvatar member={advisor.slug} class="advisor__photo" />
                <div>
                  <h3 class="advisor__name">{advisor.name}</h3>
                  <p class="advisor__role">{advisor.role}</p>
                </div>
              </div>
              <p class="advisor__strengths">{advisor.strengths}</p>
              <p class="advisor__lede">{advisor.lede}</p>
              <p class="advisor__credential">{advisor.credential}</p>
              <a
                class="advisor__link"
                href={advisor.linkedIn}
                target="_blank"
                rel="noopener noreferrer"
              >
                {advisor.name.split(' ')[0]} on LinkedIn <span aria-hidden="true">&nearr;</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- When founders call -->
    <section class="block" aria-labelledby="when-heading">
      <div class="container">
        <p class="eyebrow">When founders bring us in</p>
        <h2 id="when-heading" class="block__title">What worked before is no longer enough.</h2>

        <ul class="moments">
          {inflectionPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Proof -->
    <section class="block block--alt" aria-labelledby="proof-heading">
      <div class="container">
        <p class="eyebrow">Selected advisory work</p>
        <h2 id="proof-heading" class="block__title">Recent problems we have worked through.</h2>

        <ul class="examples">
          {homepageExamples.map((example) => (
            <li class="example">
              <p class="example__meta">
                <span class="example__stage">{example.stage}</span>
                <span class="example__sector">{example.sector}</span>
              </p>
              <p class="example__body">{example.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="block" aria-labelledby="beyond-heading">
      <div class="container">
        <p class="eyebrow">Beyond advisory</p>
        <h2 id="beyond-heading" class="block__title">We build and invest too.</h2>
        <div class="sidecards sidecards--row">
          <div class="sidecard">
            <h3 class="sidecard__title">faibuddy</h3>
            <p>
              <a href={site.faibuddyUrl} target="_blank" rel="noopener noreferrer">faibuddy</a> is
              the AI advisory product we are building for founders.
            </p>
          </div>
          <div class="sidecard">
            <h3 class="sidecard__title">Investing</h3>
            <p>
              We are beginning to make selective private-market investments in founder-led
              companies, funds and aligned SPVs.
            </p>
          </div>
        </div>
      </div>
    </section>

    <CtaStrip>
      <span slot="heading">Tell us what decision is in front of you.</span>
      <Button slot="actions" variant="primary" href={site.cta.href} size="large">
        {site.cta.label}
      </Button>
    </CtaStrip>
  </main>

  <Footer />
</Base>

<style>
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .block {
    padding-block: clamp(56px, 8vw, 104px);
  }

  .block--alt {
    background: var(--color-bg-alt);
    border-block: 1px solid var(--color-border);
  }

  .block__title {
    margin-top: var(--space-3);
    max-width: 20ch;
  }

  .block__sub {
    margin-top: var(--space-4);
    max-width: var(--readw);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* ---------- hero ---------- */
  .hero {
    padding-block: clamp(72px, 12vw, 148px) clamp(56px, 8vw, 96px);
  }

  .hero__title {
    margin-top: var(--space-3);
    max-width: 22ch;
  }

  .hero__sub {
    margin-top: var(--space-6);
    max-width: 58ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .hero__fit {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    max-width: 60ch;
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  /* ---------- advisors ---------- */
  .advisor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .advisor {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
  }

  .advisor__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
  }

  .advisor :global(.advisor__photo) {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  .advisor__name {
    font-size: var(--text-lg);
  }

  .advisor__role {
    margin-top: 2px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
  }

  .advisor__strengths {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .advisor__lede {
    font-size: var(--text-base);
    color: var(--color-text);
    min-height: 4.5rem;
  }

  .advisor__credential {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    min-height: 5.75rem;
  }

  .advisor__link {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  /* ---------- moments ---------- */
  .moments {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .moments li {
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  /* ---------- examples ---------- */
  .examples {
    list-style: none;
    padding: 0;
    margin-top: var(--space-7);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .example {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
  }

  .example__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .example__stage,
  .example__sector {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: var(--r-sm);
  }

  .example__stage {
    background: var(--blue-soft);
    color: var(--color-accent);
  }

  .example__sector {
    background: var(--paper-3);
    color: var(--color-text-muted);
  }

  .example__body {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .sidecards {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .sidecards--row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: var(--space-7);
  }

  .sidecard {
    padding: var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
  }

  .sidecard__title {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .sidecard p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 880px) {
    .advisor-grid,
    .examples,
    .moments,
    .sidecards--row {
      grid-template-columns: 1fr;
    }

    .hero__title {
      max-width: none;
    }

    .advisor__lede,
    .advisor__credential {
      min-height: 0;
    }
  }
</style>
