---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import CtaStrip from '../components/CtaStrip.astro';
import TeamAvatar from '../components/TeamAvatar.astro';
import ThesisDiagram from '../components/ThesisDiagram.astro';
import { site } from '../config/site';
import { advisors } from '../data/advisors';
import { inflectionPoints, engagementExamples } from '../data/engagements';
import { attribution, investingBoundary, participation, participationLine } from '../data/thesis';

const pageTitle = 'Founder advisory across the AI stack | Freedom with AI';
const pageDescription = site.summary;
---

<Base title={pageTitle} description={pageDescription}>
  <Nav />

  <main id="main-content">
    <!-- Hero: typographic. The old illustrated hero showed figures escaping an
         office, which was the retired positioning drawn as art. -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container">
        <p class="eyebrow">Advisory for founders building across the AI stack</p>
        <h1 id="hero-heading" class="hero__title">
          When the next move is not obvious.
        </h1>

        <p class="hero__sub">
          Work directly with Sonia or Cammie on the strategic decisions involved in building and
          growing a company, with added depth across product, technology, growth, regulation and risk.
        </p>

        <div class="cta-row">
          <Button variant="primary" href={site.cta.href} size="large">
            {site.cta.label}
          </Button>
          <Button variant="secondary" href="#advisors" size="large">Meet the advisors</Button>
        </div>

        <p class="hero__fit">
          We work across industries, especially where products, buying decisions, operations or
          regulation are complex.
        </p>
      </div>
    </section>

    <!-- The diagram carries its own title and accessible outline, so the home
         page presents the framework immediately after the thesis statement. -->
    <section class="thesis on-dark" aria-labelledby="thesis-heading">
      <div class="container">
        <p class="eyebrow">Our thesis</p>
        <h2 id="thesis-heading" class="thesis__title">
          AI is not a software category. It is a stack.
        </h2>
        <p class="thesis__lede">
          Energy, Chips, Infrastructure, Models, Applications. Push on one layer and the others
          move. The companies worth building will get built in all five, and at the seams between
          them.
        </p>

        <ThesisDiagram />

        <div class="thesis__foot">
          <p class="thesis__limit">
            We are not designing chips or building power plants. We work on the part every company
            at every layer still has to get right: turning a technical breakthrough into a product,
            finding who will actually buy it, and building a business that holds up.
          </p>
          <p class="thesis__more">
            <a href="/thesis">Read the full thesis <span aria-hidden="true">&rarr;</span></a>
          </p>
          <p class="thesis__credit">
            <a href={attribution.sourceHref} target="_blank" rel="noopener noreferrer">
              {attribution.shortLabel} <span aria-hidden="true">&nearr;</span>
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- How we participate. Replaces the old "Beyond advisory" block, which
         said the same thing without connecting it to anything. -->
    <section class="block" aria-labelledby="participate-heading">
      <div class="container">
        <p class="eyebrow">How we participate</p>
        <h2 id="participate-heading" class="block__title">Build, Advise and Invest</h2>

        <div class="modes">
          {participation.map((mode) => (
            <article class="mode">
              <h3 class="mode__title">{mode.mode}</h3>
              <p class="mode__body">{mode.body}</p>
              {mode.link && (
                <a
                  class="mode__link"
                  href={mode.link.href}
                  target={mode.link.external ? '_blank' : undefined}
                  rel={mode.link.external ? 'noopener noreferrer' : undefined}
                >
                  {mode.link.label}{' '}
                  <span aria-hidden="true">{mode.link.external ? '↗' : '→'}</span>
                </a>
              )}
            </article>
          ))}
        </div>

        <p class="modes__line">{participationLine}</p>
        <p class="modes__note">{investingBoundary}</p>
      </div>
    </section>

    <section class="block block--alt" id="advisors" aria-labelledby="advisors-heading">
      <div class="container">
        <h2 id="advisors-heading" class="block__title">Advisors</h2>

        <div class="advisor-grid">
          {advisors.map((advisor) => (
            <article class="advisor">
              <div class="advisor__head">
                <TeamAvatar member={advisor.slug} class="advisor__photo" />
                <div>
                  <h3 class="advisor__name">{advisor.name}</h3>
                  <p class="advisor__role">{advisor.role}</p>
                </div>
              </div>
              <p class="advisor__strengths">{advisor.strengths}</p>
              <p class="advisor__lede">{advisor.lede}</p>
              <p class="advisor__credential">{advisor.credential}</p>
              <a
                class="advisor__link"
                href={advisor.linkedIn}
                target="_blank"
                rel="noopener noreferrer"
              >
                {advisor.name.split(' ')[0]} on LinkedIn <span aria-hidden="true">&nearr;</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- When founders call -->
    <section class="block" aria-labelledby="when-heading">
      <div class="container">
        <p class="eyebrow">When founders bring us in</p>
        <h2 id="when-heading" class="block__title">What worked before is no longer enough.</h2>

        <ul class="moments">
          {inflectionPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Proof -->
    <section class="block block--alt" aria-labelledby="proof-heading">
      <div class="container">
        <p class="eyebrow">Selected advisory work</p>
        <h2 id="proof-heading" class="block__title">Recent problems we have worked through.</h2>

        <ul class="examples">
          {engagementExamples.map((example) => (
            <li class="example">
              <p class="example__meta">
                <span class="example__stage">{example.stage}</span>
                <span class="example__sector">{example.sector}</span>
              </p>
              <p class="example__body">{example.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaStrip>
      <span slot="heading">Tell us what decision is in front of you.</span>
      <Button slot="actions" variant="primary" href={site.cta.href} size="large">
        {site.cta.label}
      </Button>
    </CtaStrip>
  </main>

  <Footer />
</Base>

<style>
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .block {
    padding-block: clamp(56px, 8vw, 104px);
  }

  .block--alt {
    background: var(--color-bg-alt);
    border-block: 1px solid var(--color-border);
  }

  .block__title {
    margin-top: var(--space-3);
    max-width: 20ch;
  }

  .block__sub {
    margin-top: var(--space-4);
    max-width: var(--readw);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* ---------- hero ---------- */
  .hero {
    padding-block: clamp(72px, 12vw, 148px) clamp(56px, 8vw, 96px);
  }

  .hero__title {
    margin-top: var(--space-3);
    max-width: 22ch;
  }

  .hero__sub {
    margin-top: var(--space-6);
    max-width: 58ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .hero__fit {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    max-width: 60ch;
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  /* ---------- advisors ---------- */
  .advisor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .advisor {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
  }

  .advisor__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
  }

  .advisor :global(.advisor__photo) {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  .advisor__name {
    font-size: var(--text-lg);
  }

  .advisor__role {
    margin-top: 2px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
  }

  .advisor__strengths {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .advisor__lede {
    font-size: var(--text-base);
    color: var(--color-text);
    min-height: 4.5rem;
  }

  .advisor__credential {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    min-height: 5.75rem;
  }

  .advisor__link {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  /* ---------- moments ---------- */
  .moments {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .moments li {
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  /* ---------- examples ---------- */
  .examples {
    list-style: none;
    padding: 0;
    margin-top: var(--space-7);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .example {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--r);
  }

  .example__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .example__stage,
  .example__sector {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: var(--r-sm);
  }

  .example__stage {
    background: var(--blue-soft);
    color: var(--color-accent);
  }

  .example__sector {
    background: var(--paper-3);
    color: var(--color-text-muted);
  }

  .example__body {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ---------- thesis ---------- */
  .thesis {
    padding-block: clamp(64px, 9vw, 112px);
    background: #020812;
  }

  .thesis__title {
    margin-top: var(--space-3);
    max-width: 24ch;
  }

  .thesis__lede {
    margin-top: var(--space-5);
    max-width: 62ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .thesis :global(.stack) {
    margin-top: clamp(56px, 7vw, 80px);
  }

  .thesis__foot {
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .thesis__limit {
    max-width: var(--readw);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .thesis__more {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .thesis__more a {
    text-decoration: none;
  }

  /* Source credit for the diagram. Deliberately the quietest type on the
     section: present for anyone checking, invisible to anyone skimming. */
  .thesis__credit {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--color-text-subtle);
  }

  .thesis__credit a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .thesis__credit a:hover {
    color: var(--color-text);
  }

  /* ---------- build, advise, invest ---------- */
  .modes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .mode {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-accent);
  }

  .mode__title {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .mode__body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .mode__link {
    margin-top: auto;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .modes__line {
    margin-top: var(--space-7);
    max-width: var(--readw);
    font-size: var(--text-md);
    color: var(--color-text);
  }

  .modes__note {
    margin-top: var(--space-4);
    max-width: var(--readw);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  @media (max-width: 880px) {
    .advisor-grid,
    .examples,
    .moments,
    .modes {
      grid-template-columns: 1fr;
    }

    .hero__title {
      max-width: none;
    }

    .advisor__lede,
    .advisor__credential {
      min-height: 0;
    }
  }
</style>
