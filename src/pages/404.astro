---
/**
 * Served by Cloudflare Pages, with a real 404 status, for any path that does
 * not exist. Without this file Pages falls back to the homepage with a 200,
 * so a guessed URL like /pricing looks like a real page to crawlers and AI
 * agents. Kept out of the sitemap and the AI-readable files.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site } from '../config/site';
import '../styles/content-pages.css';

const pages = [
  { label: 'Home', href: '/' },
  { label: 'Advisory', href: '/advisory/' },
  { label: 'Investing', href: '/investing/' },
  { label: 'Thesis', href: '/thesis/' },
  { label: 'Contact', href: '/contact/' },
];
---

<Base
  title="Page not found | Freedom with AI"
  description="This page does not exist on freedomwith.ai."
  noindex
>
  <Nav />

  <main id="main-content">
    <section class="page-hero" aria-labelledby="notfound-heading">
      <div class="container">
        <SectionHeader label="404" align="left" />
        <h1 id="notfound-heading" class="page-hero__title">Page not found.</h1>
        <p class="page-hero__lede">
          This page does not exist. Everything on the site is linked below, and a complete
          AI-readable version is at <a href="/llms-full.txt">/llms-full.txt</a>.
        </p>

        <ul class="notfound__links">
          {pages.map((page) => (
            <li>
              <a href={page.href}>{page.label} <span aria-hidden="true">&rarr;</span></a>
            </li>
          ))}
        </ul>

        <div class="page-hero__cta">
          <Button variant="primary" href={site.cta.href} size="large" track="notfound_advisory">
            Start a conversation
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .notfound__links {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    font-size: var(--text-md);
    font-weight: 600;
  }

  .notfound__links a {
    text-decoration: none;
  }
</style>
