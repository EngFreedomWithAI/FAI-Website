---
/**
 * The AI industrial stack.
 *
 * Desktop is a single, responsive SVG intentionally redrawn from
 * public/images/FAI-Thesis.png. Keeping all geometry in one viewBox prevents
 * the alignment drift that occurred when the artwork was assembled from
 * independently sized HTML boxes.
 *
 * Mobile is a purpose-built semantic layout rather than a shrunken desktop
 * poster. The visually hidden outline remains the canonical accessible and
 * machine-readable description for both versions.
 */
import StackIcon from './StackIcon.astro';
import {
  companyBuildingLayer,
  stackLayers,
  thesisLine,
} from '../data/thesis';

const layerY = [112, 182, 252, 322, 392];
---

<figure class="stack" aria-labelledby="stack-accessible-title">
  <div class="stack__meaning">
    <h2 id="stack-accessible-title">The AI industrial stack</h2>
    <p>{thesisLine}</p>
    <ol>
      {stackLayers.map((layer) => <li>{layer.name}</li>)}
    </ol>
    <h3>{companyBuildingLayer.label}</h3>
    <p>{companyBuildingLayer.path.join(' to ')}.</p>
    <p>Disciplines: {companyBuildingLayer.disciplines.join(', ')}.</p>
    <p>Freedom with AI participates in three ways: Build, Advise and Invest.</p>
    <p>{thesisLine}</p>
  </div>

  <!-- One coordinate system keeps the desktop composition precise at any size. -->
  <svg
    class="stack__desktop"
    viewBox="32 72 960 504"
    role="img"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="layer-top" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#071b38" />
        <stop offset="100%" stop-color="#0b1728" />
      </linearGradient>
      <linearGradient id="layer-mid" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#1c2734" />
        <stop offset="100%" stop-color="#202a35" />
      </linearGradient>
      <linearGradient id="layer-low" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#18232d" />
        <stop offset="100%" stop-color="#1c2731" />
      </linearGradient>

      <symbol id="td-cube" viewBox="0 0 24 24">
        <path d="M12 2.4 20.8 7v10L12 21.6 3.2 17V7zM3.2 7 12 11.6 20.8 7M12 11.6v10" />
      </symbol>
      <symbol id="td-nodes" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="2.3" />
        <circle cx="4.6" cy="5.4" r="1.9" />
        <circle cx="19.4" cy="5.4" r="1.9" />
        <circle cx="4.6" cy="18.6" r="1.9" />
        <circle cx="19.4" cy="18.6" r="1.9" />
        <path d="m6 6.8 4.3 3.6M18 6.8l-4.3 3.6M6 17.2l4.3-3.6M18 17.2l-4.3-3.6" />
      </symbol>
      <symbol id="td-cloud" viewBox="0 0 24 24">
        <path d="M17.4 12.4a3 3 0 0 0-1.4-5.7 4.5 4.5 0 0 0-8.5 1.5 2.9 2.9 0 0 0 .3 4.2z" />
        <rect x="4.2" y="14.9" width="15.6" height="3.2" rx=".7" />
        <rect x="4.2" y="19.2" width="15.6" height="3.2" rx=".7" />
        <path d="M7 16.5h.01M7 20.8h.01" />
      </symbol>
      <symbol id="td-chip" viewBox="0 0 24 24">
        <rect x="6.8" y="6.8" width="10.4" height="10.4" rx="1.3" />
        <rect x="10.2" y="10.2" width="3.6" height="3.6" rx=".6" />
        <path d="M9.8 3.2v3.6M14.2 3.2v3.6M9.8 17.2v3.6M14.2 17.2v3.6M3.2 9.8h3.6M3.2 14.2h3.6M17.2 9.8h3.6M17.2 14.2h3.6" />
      </symbol>
      <symbol id="td-bolt" viewBox="0 0 24 24">
        <path d="M13.6 2 4.8 13.6h6.2L10.4 22l8.8-11.6h-6.2z" />
      </symbol>
    </defs>

    <rect width="1024" height="576" fill="#020812" />

    <text
      class="svg-column-title"
      x="106"
      y="96"
      style="fill:#81adfa;font-size:15px;font-weight:700;letter-spacing:1.15px"
    >
      THE AI INDUSTRIAL STACK
    </text>

    {stackLayers.map((layer, index) => (
      <g class="svg-layer">
        <rect
          x="106"
          y={layerY[index]}
          width="493"
          height="66"
          rx="1"
          fill={index === 0 ? 'url(#layer-top)' : index < 4 ? 'url(#layer-mid)' : 'url(#layer-low)'}
        />
        <rect
          x="106.5"
          y={layerY[index] + 0.5}
          width="492"
          height="65"
          rx=".5"
          fill="none"
          stroke="#6687aa"
          stroke-opacity={index === 0 ? '.38' : '.28'}
        />
        <line
          x1="218"
          y1={layerY[index] + 13}
          x2="218"
          y2={layerY[index] + 53}
          stroke="#8aa0b8"
          stroke-opacity=".52"
        />
        <use
          href={`#td-${layer.icon}`}
          x="140"
          y={layerY[index] + 14}
          width="38"
          height="38"
          fill="none"
          stroke="#72a9ff"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <text class="svg-layer-name" x="241" y={layerY[index] + 43}>{layer.name.toUpperCase()}</text>
      </g>
    ))}

    <!-- Continuous brace: one path avoids seams at the centre point. -->
    <path
      d="M643 115h5c7 0 11 4 11 12v131c0 9 4 14 15 14-11 0-15 5-15 14v150c0 8-4 12-11 12h-5"
      fill="none"
      stroke="#79a9ef"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <text
      class="svg-column-title"
      x="829"
      y="96"
      text-anchor="middle"
      style="fill:#81adfa;font-size:15px;font-weight:700;letter-spacing:1.15px"
    >
      {companyBuildingLayer.label.toUpperCase()}
    </text>

    <text class="svg-path" x="829" y="145" text-anchor="middle">Capability</text>
    <path class="svg-arrow" d="M829 154v18m-5-5 5 5 5-5" />
    <text class="svg-path" x="829" y="203" text-anchor="middle">Product</text>
    <path class="svg-arrow" d="M829 212v18m-5-5 5 5 5-5" />
    <text class="svg-path" x="829" y="261" text-anchor="middle">Market</text>
    <path class="svg-arrow" d="M829 270v18m-5-5 5 5 5-5" />
    <text class="svg-path" x="829" y="328" text-anchor="middle">Enduring business</text>

    <line x1="706" y1="363" x2="946" y2="363" stroke="#7391b5" stroke-opacity=".72" />
    <text class="svg-disciplines" x="826" y="389" text-anchor="middle">
      Product · Business model · GTM ·
    </text>
    <text class="svg-disciplines" x="826" y="410" text-anchor="middle">
      Partnerships · Regulation · Governance
    </text>

    <line x1="0" y1="474" x2="1024" y2="474" stroke="#527aa8" stroke-opacity=".62" />
    <g class="svg-modes">
      <line x1="45" y1="508" x2="227" y2="508" />
      <circle cx="46" cy="508" r="2" />
      <circle cx="226" cy="508" r="2" />
      <text x="264" y="518">BUILD</text>
      <circle cx="409" cy="508" r="2.5" />
      <text x="447" y="518">ADVISE</text>
      <circle cx="620" cy="508" r="2.5" />
      <text x="660" y="518">INVEST</text>
      <line x1="827" y1="508" x2="979" y2="508" />
      <circle cx="828" cy="508" r="2" />
      <circle cx="978" cy="508" r="2" />
    </g>
    <text
      class="svg-thesis-line"
      x="512"
      y="550"
      text-anchor="middle"
      style="fill:#b7cee6;font-size:16px;letter-spacing:.2px"
    >
      {thesisLine}
    </text>
  </svg>

  <!-- A deliberate mobile composition: readable, touch-scale, and not a tiny poster. -->
  <div class="stack__mobile on-dark" aria-hidden="true">
    <header class="mobile-head">
      <p class="mobile-title">The AI industrial stack</p>
    </header>

    <ol class="mobile-layers">
      {stackLayers.map((layer) => (
        <li>
          <span class="mobile-icon"><StackIcon name={layer.icon} /></span>
          <span>{layer.name}</span>
        </li>
      ))}
    </ol>

    <section class="mobile-company">
      <p class="mobile-label">{companyBuildingLayer.label}</p>
      <ol class="mobile-path">
        {companyBuildingLayer.path.map((step, index) => (
          <li>
            <span>{step}</span>
            {index < companyBuildingLayer.path.length - 1 && <span class="mobile-arrow">↓</span>}
          </li>
        ))}
      </ol>
      <p class="mobile-disciplines">{companyBuildingLayer.disciplines.join(' · ')}</p>
    </section>

    <footer class="mobile-footer">
      <p class="mobile-modes">Build <span>·</span> Advise <span>·</span> Invest</p>
      <p class="mobile-thesis-line">{thesisLine}</p>
    </footer>
  </div>
</figure>

<style>
  .stack {
    margin: 0;
  }

  .stack__meaning {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .stack__desktop {
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }

  .svg-layer-name {
    fill: #f7f8fa;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .svg-column-title {
    fill: #81adfa;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1.15px;
  }

  .svg-path {
    fill: #f7f8fa;
    font-size: 18px;
    font-weight: 500;
  }

  .svg-arrow {
    fill: none;
    stroke: #76a9f9;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .svg-disciplines {
    fill: #b5bac4;
    font-size: 13px;
  }

  .svg-modes {
    fill: #f7f8fa;
    stroke: #7caafa;
    stroke-width: 1.25;
    font-size: 31px;
    font-weight: 500;
    letter-spacing: 5px;
  }

  .svg-modes text {
    stroke: none;
  }

  .svg-thesis-line {
    fill: #81adfa;
    font-size: 15px;
    letter-spacing: 0.35px;
  }

  .stack__mobile {
    display: none;
  }

  @media (max-width: 720px) {
    .stack__desktop {
      display: none;
    }

    .stack__mobile {
      display: block;
      overflow: hidden;
      border: 1px solid rgba(129, 173, 250, 0.2);
      border-radius: var(--r-lg);
      background: #020812;
    }

    .mobile-head {
      padding: 24px 20px 22px;
      text-align: center;
    }

    .mobile-title {
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.14em;
      line-height: 1.4;
      text-transform: uppercase;
      color: #81adfa;
    }

    .mobile-layers {
      display: grid;
      gap: 5px;
      margin: 0;
      padding: 0 14px;
      list-style: none;
    }

    .mobile-layers li {
      display: flex;
      align-items: center;
      min-height: 56px;
      border: 1px solid rgba(129, 173, 250, 0.18);
      background: linear-gradient(90deg, rgba(42, 57, 73, 0.84), rgba(25, 36, 49, 0.72));
      color: var(--color-text);
      font-size: clamp(0.85rem, 4vw, 1rem);
      font-weight: 600;
      letter-spacing: 0.035em;
      text-transform: uppercase;
    }

    .mobile-layers li:first-child {
      background: linear-gradient(90deg, rgba(8, 30, 63, 0.95), rgba(8, 22, 42, 0.84));
    }

    .mobile-icon {
      display: grid;
      flex: 0 0 58px;
      align-self: stretch;
      place-items: center;
      margin-right: 16px;
      border-right: 1px solid rgba(157, 192, 224, 0.38);
      color: #72a9ff;
    }

    .mobile-icon :global(svg) {
      width: 27px;
      height: 27px;
    }

    .mobile-company {
      margin: 34px 14px 0;
      padding: 24px 18px;
      border-block: 1px solid rgba(129, 173, 250, 0.25);
      text-align: center;
    }

    .mobile-label {
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #81adfa;
    }

    .mobile-path {
      margin: 18px 0 0;
      padding: 0;
      list-style: none;
    }

    .mobile-path li {
      display: flex;
      flex-direction: column;
      align-items: center;
      color: var(--color-text);
      font-size: var(--text-base);
      font-weight: 500;
    }

    .mobile-arrow {
      padding: 2px 0;
      color: #72a9ff;
      font-weight: 400;
    }

    .mobile-disciplines {
      margin: 20px auto 0;
      max-width: 32ch;
      font-size: var(--text-xs);
      line-height: 1.7;
      color: var(--color-text-muted);
    }

    .mobile-footer {
      padding: 28px 16px 30px;
      text-align: center;
    }

    .mobile-modes {
      font-size: clamp(1rem, 5.2vw, 1.3rem);
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text);
    }

    .mobile-modes span {
      color: #72a9ff;
    }

    .mobile-thesis-line {
      margin-top: 10px;
      font-size: var(--text-sm);
      line-height: 1.5;
      color: #81adfa;
    }
  }
</style>
