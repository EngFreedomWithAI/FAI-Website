---
/**
 * Layer icons for the stack diagram.
 *
 * Paths are Lucide (https://lucide.dev, ISC licence), inlined rather than
 * pulled from a package so the site ships five paths instead of two thousand
 * unused SVGs and needs no icon dependency at build time.
 *
 * Stroke is 1.6 rather than Lucide's default 2: at the 30px the diagram renders
 * them, 2 reads chunky against this site's light typographic weight.
 */
import type { LayerIcon } from '../data/thesis';

interface Props {
  name: LayerIcon;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['stack-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {/* cube: applications and machines that act in the world */}
  {name === 'cube' && (
    <Fragment>
      <path d="M12 2.4 20.8 7v10L12 21.6 3.2 17V7z" />
      <path d="M3.2 7 12 11.6 20.8 7" />
      <path d="M12 11.6v10" />
    </Fragment>
  )}

  {/* connected nodes: models */}
  {name === 'nodes' && (
    <Fragment>
      <circle cx="12" cy="12" r="2.3" />
      <circle cx="4.6" cy="5.4" r="1.9" />
      <circle cx="19.4" cy="5.4" r="1.9" />
      <circle cx="4.6" cy="18.6" r="1.9" />
      <circle cx="19.4" cy="18.6" r="1.9" />
      <path d="m6 6.8 4.3 3.6M18 6.8l-4.3 3.6M6 17.2l4.3-3.6M18 17.2l-4.3-3.6" />
    </Fragment>
  )}

  {/* cloud and servers: infrastructure */}
  {name === 'cloud' && (
    <Fragment>
      <path d="M17.4 12.4a3 3 0 0 0-1.4-5.7 4.5 4.5 0 0 0-8.5 1.5 2.9 2.9 0 0 0 .3 4.2z" />
      <rect x="4.2" y="14.9" width="15.6" height="3.2" rx="0.7" />
      <rect x="4.2" y="19.2" width="15.6" height="3.2" rx="0.7" />
      <path d="M7 16.5h.01M7 20.8h.01" />
    </Fragment>
  )}

  {/* chip: compute */}
  {name === 'chip' && (
    <Fragment>
      <rect x="6.8" y="6.8" width="10.4" height="10.4" rx="1.3" />
      <rect x="10.2" y="10.2" width="3.6" height="3.6" rx="0.6" />
      <path d="M9.8 3.2v3.6M14.2 3.2v3.6M9.8 17.2v3.6M14.2 17.2v3.6" />
      <path d="M3.2 9.8h3.6M3.2 14.2h3.6M17.2 9.8h3.6M17.2 14.2h3.6" />
    </Fragment>
  )}

  {/* bolt: energy */}
  {name === 'bolt' && <path d="M13.6 2 4.8 13.6h6.2L10.4 22l8.8-11.6h-6.2z" />}
</svg>

<style>
  .stack-icon {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
