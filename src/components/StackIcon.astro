---
/**
 * Layer icons for the stack diagram.
 *
 * Paths are Lucide (https://lucide.dev, ISC licence), inlined rather than
 * pulled from a package so the site ships five paths instead of two thousand
 * unused SVGs and needs no icon dependency at build time.
 *
 * Stroke is 1.6 rather than Lucide's default 2: at the 30px the diagram renders
 * them, 2 reads chunky against this site's light typographic weight.
 */
import type { LayerIcon } from '../data/thesis';

interface Props {
  name: LayerIcon;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['stack-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {/* bot: applications, including the ones that move in the world */}
  {name === 'bot' && (
    <Fragment>
      <path d="M12 8V4H8" />
      <rect width="16" height="12" x="4" y="8" rx="2" />
      <path d="M2 14h2" />
      <path d="M20 14h2" />
      <path d="M15 13v2" />
      <path d="M9 13v2" />
    </Fragment>
  )}

  {/* waypoints */}
  {name === 'nodes' && (
    <Fragment>
      <path d="m10.586 5.414-5.172 5.172" />
      <path d="m18.586 13.414-5.172 5.172" />
      <path d="M6 12h12" />
      <circle cx="12" cy="20" r="2" />
      <circle cx="12" cy="4" r="2" />
      <circle cx="20" cy="12" r="2" />
      <circle cx="4" cy="12" r="2" />
    </Fragment>
  )}

  {/* server */}
  {name === 'server' && (
    <Fragment>
      <rect width="20" height="8" x="2" y="2" rx="2" ry="2" />
      <rect width="20" height="8" x="2" y="14" rx="2" ry="2" />
      <line x1="6" x2="6.01" y1="6" y2="6" />
      <line x1="6" x2="6.01" y1="18" y2="18" />
    </Fragment>
  )}

  {/* cpu */}
  {name === 'cpu' && (
    <Fragment>
      <path d="M12 20v2" />
      <path d="M12 2v2" />
      <path d="M17 20v2" />
      <path d="M17 2v2" />
      <path d="M7 20v2" />
      <path d="M7 2v2" />
      <path d="M2 12h2" />
      <path d="M2 17h2" />
      <path d="M2 7h2" />
      <path d="M20 12h2" />
      <path d="M20 17h2" />
      <path d="M20 7h2" />
      <rect x="4" y="4" width="16" height="16" rx="2" />
      <rect x="8" y="8" width="8" height="8" rx="1" />
    </Fragment>
  )}

  {/* zap */}
  {name === 'zap' && (
    <path
      d="M15.914 4a1.5 1.5 0 0 0-2.474-1.561l-9 9A1.5 1.5 0 0 0 5.5 14h4.002a.5.5 0 0 1 .471.666L8.086 20a1.5 1.5 0 0 0 2.475 1.56l9-9A1.5 1.5 0 0 0 18.5 10h-3.997a.5.5 0 0 1-.472-.667z"
    />
  )}
</svg>

<style>
  .stack-icon {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
