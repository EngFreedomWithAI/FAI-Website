---
/**
 * Where the money has moved: bits, bits buy atoms, bits drive atoms, space.
 * Designed for the dark bands. A real ordered list, so it reads correctly
 * without styles and needs no separate accessible outline.
 */
import { arc } from '../data/thesis';

interface Props {
  /** Show what investors reward at each step. Used on /thesis. */
  showRewards?: boolean;
}

const { showRewards = false } = Astro.props;
---

<ol class="arc" aria-label="Where the money moves next">
  {arc.map((step) => (
    <li class:list={['arc__step', step.focus && 'arc__step--focus']}>
      <span class="arc__dot" aria-hidden="true"></span>
      <p class="arc__when">{step.when}</p>
      <h3 class="arc__name">{step.name}</h3>
      <p class="arc__body">{step.body}</p>
      {showRewards && (
        <p class="arc__rewards">
          <span class="arc__rewards-label">Investors reward</span>
          {step.rewards}
        </p>
      )}
    </li>
  ))}
</ol>

<style>
  .arc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    position: relative;
  }

  /* The track: a hairline that brightens toward the step we focus on. */
  .arc::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(129, 173, 250, 0.15),
      rgba(129, 173, 250, 0.45) 70%,
      #81adfa
    );
  }

  .arc__step {
    position: relative;
    padding: var(--space-6) var(--space-5) 0 0;
  }

  .arc__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #020812;
    border: 1.5px solid rgba(129, 173, 250, 0.6);
  }

  .arc__step--focus .arc__dot {
    background: #81adfa;
    border-color: #81adfa;
    box-shadow: 0 0 0 6px rgba(129, 173, 250, 0.16);
  }

  .arc__when {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .arc__step--focus .arc__when {
    color: #81adfa;
  }

  .arc__name {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
  }

  .arc__step--focus .arc__name {
    color: #ffffff;
  }

  .arc__body {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 30ch;
  }

  .arc__rewards {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text);
    max-width: 30ch;
  }

  .arc__rewards-label {
    display: block;
    margin-bottom: 2px;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  @media (max-width: 880px) {
    .arc {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      padding-left: var(--space-6);
    }

    .arc::before {
      top: 0;
      bottom: 0;
      left: 7px;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(
        180deg,
        rgba(129, 173, 250, 0.15),
        rgba(129, 173, 250, 0.45) 70%,
        #81adfa
      );
    }

    .arc__step {
      padding: 0;
    }

    .arc__dot {
      top: 2px;
      left: calc(-1 * var(--space-6));
    }

    .arc__body,
    .arc__rewards {
      max-width: none;
    }
  }
</style>
